# Datadog Feature Flags (client-side)
# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed vars.
# Restart the dev server after changing these.

# RUM application ID. Must match the app ID given to your RUM SDK.
VITE_DD_APPLICATION_ID=

# Datadog client token. Create under Organization Settings > Client Tokens.
VITE_DD_CLIENT_TOKEN=

VITE_DD_SITE=datadoghq.com
VITE_DD_ENV=dev

# Release tag for RUM and Logs. Optional - defaults to 1.0.0.
# prod-sample-react.sh sets 2.0.0 to match prod-sample-java-api.sh.
VITE_DD_VERSION=1.0.0

# sample-java-api origin, used by the sign-in form's getUserProfile call.
# Optional - defaults to http://localhost:8080.
VITE_API_BASE_URL=http://localhost:8080
