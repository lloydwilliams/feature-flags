<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging for sample-java-api.

  Named logback-spring.xml rather than logback.xml so Spring Boot owns the
  initialization (and <springProfile> / <springProperty> stay available).

  The dd.* values in the pattern come from MDC, populated by the tracer's
  -Ddd.logs.injection=true in run-sample-java-api.sh. Without the agent
  attached they render as empty brackets rather than failing.
-->
<configuration>

    <property name="LOGS" value="./logs" />

    <!-- One pattern for both appenders, so console and file lines match. -->
    <property name="LOG_PATTERN"
        value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ} %-5p [%thread] [%c{1} %method:%L] [%X{dd.trace_id}] [%X{dd.span_id}] %m%n" />

    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>${LOG_PATTERN}</Pattern>
        </layout>
    </appender>

    <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/sample-java-api.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>${LOG_PATTERN}</Pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Rollover daily and when the file reaches 10MB. -->
            <fileNamePattern>${LOGS}/archived/sample-java-api-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>10MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <!-- Bounded, so a long-running demo cannot fill the disk. -->
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <root level="info">
        <appender-ref ref="RollingFile" />
        <appender-ref ref="Console" />
    </root>

    <!-- This app's own classes. Switch to debug or trace when investigating. -->
    <logger name="com.example.samplejavaapi" level="info" additivity="false">
        <appender-ref ref="RollingFile" />
        <appender-ref ref="Console" />
    </logger>

</configuration>
