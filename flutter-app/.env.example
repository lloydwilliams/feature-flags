# Datadog configuration, passed to the app at build time:
#   cp .env.example .env.local   # then fill in
#   flutter run --dart-define-from-file=.env.local
# .env.local is gitignored. Restart `flutter run` (not just hot reload) after
# changing these - dart-defines are compiled in.

# RUM application ID. Must match the RUM application in Datadog.
DD_APPLICATION_ID=

# Datadog client token. Create under Organization Settings > Client Tokens.
DD_CLIENT_TOKEN=

# Datadog site: us1, us3, us5, eu1, ap1 or ap2 (us1 is datadoghq.com).
DD_SITE=us1
# Env tag for RUM, Logs and Feature Flags. Must match an environment in
# Datadog Feature Flags for flag assignments to come back.
DD_ENV=flutter

# Release tag for RUM and Logs. Optional - defaults to 1.0.0.
DD_VERSION=1.0.0

# sample-java-api origin. Optional - defaults to http://10.0.2.2:8080, the
# Android emulator's address for the Mac running the API. On a physical
# device, run `adb reverse tcp:8080 tcp:8080` and use http://localhost:8080.
API_BASE_URL=http://10.0.2.2:8080
